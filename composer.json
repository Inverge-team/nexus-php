{
    "name": "inverge/nexus",
    "description": "Official PHP SDK for the Inverge Nexus platform — realtime, events, errors, logs, feature flags, links, sessions. Framework-agnostic with first-class Laravel and Symfony integrations.",
    "type": "library",
    "license": "MIT",
    "keywords": ["nexus", "inverge", "realtime", "websocket", "analytics", "feature-flags", "laravel", "symfony", "sdk"],
    "homepage": "https://nexus.inverge.net",
    "authors": [
        { "name": "Inverge", "homepage": "https://inverge.net" }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "monolog/monolog": "^3.0",
        "phpunit/phpunit": "^10.5",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "suggest": {
        "psr/http-client": "Bring your own PSR-18 HTTP client (e.g. Guzzle) instead of the built-in cURL transport.",
        "monolog/monolog": "Forward your app's logs to Nexus via Inverge\\Nexus\\Monolog\\NexusLogHandler (^3).",
        "illuminate/support": "Laravel integration (auto-discovered service provider + facade).",
        "symfony/http-kernel": "Symfony integration (bundle + auto error-capture listener).",
        "symfony/messenger": "Symfony async telemetry delivery (nexus: async: true)."
    },
    "autoload": {
        "psr-4": { "Inverge\\Nexus\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Inverge\\Nexus\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Inverge\\Nexus\\Laravel\\NexusServiceProvider"],
            "aliases": { "Nexus": "Inverge\\Nexus\\Laravel\\Nexus" }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
